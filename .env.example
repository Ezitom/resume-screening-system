# Copy this file to .env and fill in your actual values
# Never commit .env to GitHub

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# URL of your deployed Flask backend on Render (no trailing slash)
VITE_BACKEND_URL=https://your-render-service-name.onrender.com

# Backend Supabase environment variables
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Brevo (Sendinblue) SMTP Relay Email Configuration
# Login obtained from Brevo Dashboard -> Transactional / SMTP -> SMTP Settings
BREVO_SMTP_LOGIN=your_brevo_smtp_login_here
# SMTP key/password obtained from Brevo Dashboard -> Transactional / SMTP Settings
BREVO_SMTP_PASSWORD=your_brevo_smtp_password_here
# Sender name displayed on emails (e.g. "EBEN Recruitment")
BREVO_SENDER_NAME="EBEN Recruitment"
# Verified sender email address registered with your Brevo account
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com
