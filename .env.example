# =========================================================================
# Frontend Environment Variables (Vite client-side)
# =========================================================================
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Single Config Variable for the backend API Base URL
VITE_API_BASE_URL=your_backend_render_api_url_here

# =========================================================================
# Backend Environment Variables (Flask server-side)
# =========================================================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Brevo Configuration for Transactional Emails
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email_here
SENDER_NAME=EBEN Recruitment

# CORS Allowed Origin
ALLOWED_ORIGIN=https://ezitom.netlify.app
PORT=5000
