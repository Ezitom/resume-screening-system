# Copy this file to .env and fill in your actual values
# Never commit .env to GitHub

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# URL of your deployed Flask backend on Render (no trailing slash)
VITE_BACKEND_URL=https://your-render-service-name.onrender.com


# Brevo (Sendinblue) Transactional Email Configuration
# API key obtained from Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_api_key_here
# Name displayed as the sender in candidate inboxes
BREVO_SENDER_NAME="EBEN Recruitment"
# Verified sender email address registered in Brevo
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com

